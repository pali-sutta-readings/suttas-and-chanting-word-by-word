// Pandoc typst template for the A5 chant books (docs/book-build.md); based
// on `pandoc -D typst`. Used with templates/pandoc/chant.lua, which supplies
// cover-data-path and cover-pdf and turns the classed divs into calls of the
// functions in templates/typst/book.typ. Compile with --root at the repo root.

#import "/templates/typst/book.typ": *
#import "/templates/typst/cover.typ": cover-page

#let book = json($cover-data-path$)

$if(smart)$
$else$
#set smartquote(enabled: false)

$endif$
$for(header-includes)$
$header-includes$

$endfor$
#show: document-setup.with(
  title: book.title,
$if(lang)$
  lang: "$lang$",
$endif$
$if(region)$
  region: "$region$",
$endif$
  chant-level: $toc-depth$,
)

// Cover and blank verso; page numbers count from the About page.
$if(cover-pdf)$
#page(margin: 0pt, header: none, footer: none, image($cover-pdf$, width: 100%, height: 100%, fit: "cover"))
$else$
#cover-page(book)
$endif$
#blank-page()
#counter(page).update(1)

$for(include-before)$
$include-before$

$endfor$
$body$
$for(include-after)$

$include-after$
$endfor$
